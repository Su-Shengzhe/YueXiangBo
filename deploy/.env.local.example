# Optional host ports; defaults below. Keep values distinct.
MYSQL_PORT=13306
REDIS_PORT=16379
RABBITMQ_PORT=25672
RABBITMQ_UI_PORT=25673
REGISTRY_PORT=8761
GATEWAY_PORT=8080
PARKING_PORT=8082
