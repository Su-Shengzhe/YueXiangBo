# Run scripts/Initialize-Local.ps1 to generate local credentials.
# Exact image digests are in deploy/images.lock.json.
MYSQL_IMAGE=
REDIS_IMAGE=
RABBITMQ_IMAGE=
MYSQL_ROOT_PASSWORD=
PARKING_DB_PASSWORD=
REDIS_PASSWORD=
RABBITMQ_PASSWORD=
